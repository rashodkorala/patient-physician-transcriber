# Copy to server/.env (never commit .env). scripts/dev.sh loads it.
ANTHROPIC_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=canadacentral
# Leave blank: claude when ANTHROPIC_API_KEY is set, otherwise fake (no AI calls, for testing without keys).
TRANSLATOR=
# Leave blank: the demo uses the multilingual E5 model (download once with scripts/download_model.py).
# "hashing" is a test embedder for machines that cannot download the model; never use it on stage.
EMBEDDINGS=
